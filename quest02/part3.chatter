
use get_input from "../util/io"
use parse, split from "std:string"
use max from "std:math"
use range, uniquify from "std:list"
get_input
map it using the result of split it on " "
variable checksum is 0

function find_max takes unique list of string ordering returns number is
    constant needles is empty list of number
    repeat with order in ordering
        parse character 1 of order
        append it to needles
        parse character 3 of order
        append it to needles
    end repeat
    max needles
    return it
end function

function normalize takes string input returns string is
    if character 2 of input is "<"
        return input
    end if
    return (character 3 of input) & "<" & (character 1 of input)
end function

function fill_in_missing_orders takes unique list of string ordering is
    find_max ordering
    constant n_max is it
    variable allgood is false
    repeat while allgood is false
        change allgood to true
        repeat with x from 1 to n_max - 1
            repeat with y from x + 1 to n_max
                if ordering contains x & "<" & y or ordering contains y & "<" & x
                    next repeat
                else 
                    repeat with z from 1 to n_max
                        if ordering contains x & "<" & z and ordering contains z & "<" & y
                            add x & "<" & y to ordering
                            next repeat
                        else if  ordering contains y & "<" & z and ordering contains z & "<" & x
                            add y & "<" & x to ordering
                            next repeat
                        end if
                    end repeat # z
                end if
                change allgood to false
            end repeat # y
        end repeat # x
    end repeat
end function

# returns -1 if x < y or 1 if x > y
function deduce_rule takes number x to number y with unique list of string ordering returns number is
    if ordering contains x & "<" & y
        return -1
    else if ordering contains y & "<" & x
        return 1
    end if
    fail "No deducation for " & x & ", " & y & " using " & ordering
end function

repeat with l_ordering in it
    map l_ordering using the result of normalize it
    uniquify it
    constant ordering is it
    fill_in_missing_orders ordering
    find_max ordering
    constant n_max is it
    range 1 to n_max
    constant result is it
    repeat with i from 1 to n_max - 1
        repeat with j from i + 1 to n_max
            variable x is item i of result
            variable y is item j of result
            deduce_rule x to y with ordering
            if it is -1
                change item i of result to y
                change item j of result to x
            end if  
        end repeat
    end repeat
    reduce result starting 0 using 10 * accumulator + it
    add it to checksum
end repeat

say "ANSWER:", checksum
