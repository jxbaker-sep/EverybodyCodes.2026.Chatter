# Quest 4 — Part 3
#
# Run with:
#     ./run.py 4 3 --example     # against part3.example.txt
#     ./run.py 4 3               # against part3.txt
#
# Print the final answer using:
#     say "ANSWER:", value
# Anything else printed via `say` is ignored by run.py (treated as debug).

use max from "std:math"
use range from "std:list"
use integers from "std:parser"
use get_input from "../util/io"

constant ID is 1
constant QUEST is 2
constant PART is 3
constant TIME is 4

get_input
map it using the result of integers it
constant standings is it

map standings using item ID of it
max it
constant highest_id is it

map standings using item QUEST of it
max it
constant highest_quest is it

range 1 to highest_id
map it using 0
constant scores is it

mutable struct IdToTotalTime
    number Id
    number TotalTime
end struct

repeat with quest from 1 to highest_quest
    filter standings where item QUEST of it is quest
    constant quest_standings is it

    range 1 to highest_id
    map it using make IdToTotalTime with Id it, TotalTime 0
    constant quest_rankings is it

    repeat with part from 1 to 3
        sort quest_rankings by Id of it
        filter quest_standings where item PART of it is part
        constant part_standings is it
        map part_standings using item ID of it
        constant part_completers is it
        if length of part_completers is 0
            exit repeat
        end if
        
        repeat with standing in part_standings 
            constant id is item ID of standing
            constant time is item TIME of standing
            constant my_score is item id of quest_rankings
            add time to TotalTime of my_score
        end repeat
        sort quest_rankings by TotalTime of it
        variable n is 50 * part
        
        variable previous_time is 0
        variable previous_n is n
        repeat with index from 1 to length of quest_rankings
            constant my_score is item index of quest_rankings
            constant my_id is Id of my_score
            if not part_completers contains my_id
                next repeat
            end if
            if TotalTime of my_score is not previous_time
                change previous_n to n
                change previous_time to TotalTime of my_score
            end if
            if previous_n is at most 0
                exit repeat
            end if
            add previous_n to item my_id of scores

            subtract 1 from n
        end repeat
    end repeat

end repeat

sort scores descending

variable result is 0
variable tail is -1
variable sames is 0
repeat with index from 1 to length of scores
    if item index of scores is tail
        add 1 to sames
    else
        change sames to 0
    end if
    change tail to item index of scores
    add (index - sames) * item index of scores to result
end repeat

say "ANSWER:", result
