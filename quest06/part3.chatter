# Quest 6 — Part 3
#
# Run with:
#     ./run.py 6 3 --example     # against part3.example.txt
#     ./run.py 6 3               # against part3.txt
#
# Print the final answer using:
#     say "ANSWER:", value
# Anything else printed via `say` is ignored by run.py (treated as debug).

use intersection, union from "std:set"
use value_or from "std:dictionary"
use make_queue_with, dequeue, enqueue from "std:queue"
use split from "std:string"
use get_input from "../util/io"
get_input
constant ingredients is empty dictionary from string to list of string
repeat with line in it
    split line on ":"
    constant key is item 1 of it
    split item 2 of it on ","
    constant values is it
    repeat with vlue in values
        constant xxx is the result of value_or vlue in ingredients with empty list of string
        append key to xxx
        change value of vlue in ingredients to xxx
    end repeat
end repeat

constant nulls is empty dictionary from string to unique list of string

repeat with target in list of "NULLv1", "NULLv2", "NULLv3"
    make_queue_with target
    constant open is it
    
    constant closed is unique list of target
    
    repeat while length of open is at least 1
        constant current is the result of dequeue open
        repeat with ingredient in value of current in ingredients
            if not closed contains ingredient and ingredients contains ingredient
                enqueue open with ingredient
            end if
            add ingredient to closed
        end repeat
    end repeat

    remove target from closed
    change value of target in nulls to closed
end repeat

intersection value of "NULLv1" in nulls with value of "NULLv2" in nulls
constant temp1 is it
intersection value of "NULLv1" in nulls with value of "NULLv3" in nulls
constant temp2 is it
intersection value of "NULLv2" in nulls with value of "NULLv3" in nulls
constant temp3 is it

union temp1 with temp2
union it with temp3
say it

say "ANSWER:", length of it
# 1655: length correct, first character: correct
